{
  "name": "terrace-atlas",
  "version": "0.6.0",
  "private": true,
  "description": "Independent stadium exploration concept",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "python3 scripts/audit_clean_room.py",
    "test": "node scripts/test.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:discovery": "node tests/discovery.browser.cjs",
    "test:quality": "node tests/quality.browser.cjs",
    "record:demo": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/record-demo.cjs",
    "release": "npm run check && npm test && npm run build && python3 scripts/package_release.py",
    "test:release": "node tests/release.browser.cjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
